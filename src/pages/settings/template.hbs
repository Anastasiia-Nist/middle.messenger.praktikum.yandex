{{#> layout-page title=title mainClass="page-profile"}}
  {{#> layout layoutClass="profile-layout" contentClass="profile-layout__content" asideClass="profile-layout__aside" hasAsideBlock=true}}
    {{#*inline "aside-block"}}
      {{> settings-sidebar backHref="#/chats" backAriaLabel="Назад к чатам"}}
    {{/inline}}

    <div class="page-profile__content">
      <div class="page-profile__avatar-wrap">
        {{> ui-avatar type="button" overlayText="Поменять аватар"}}
      </div>
      <div class="title title_position_center title_size_xl">{{profileForm.fields.0.value}}</div>
      {{> ui-form formClass=profileForm.formClass name="profile-info" fields=profileForm.fields
      actions=profileForm.actions disabled=profileForm.disabled}}
      <div class="page-profile__actions">
        <div class="page-profile__actions-item">
          {{> ui-button buttonClass="page-profile__action-button button_type_link" text="Изменить данные"}}
        </div>
        <div class="page-profile__actions-item">
          {{> ui-button buttonClass="page-profile__action-button button_type_link" text="Изменить пароль"}}
        </div>
        <div class="page-profile__actions-item">
          {{> ui-button buttonClass="page-profile__action-button button_type_link button_color_danger" text="Выйти"}}
        </div>
      </div>
    </div>
  {{/layout}}
{{/layout-page}}
