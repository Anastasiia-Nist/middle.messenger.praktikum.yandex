{{#> page mainClass="page-profile"}}
  {{#> layout layoutClass="profile-layout" asideClass="profile-layout__aside" contentClass="profile-layout__content" hasAsideBlock=true}}
    {{#*inline "aside-block"}}
      {{{ SettingsSidebar backHref=backHref backAriaLabel=backAriaLabel }}}
    {{/inline}}
    <div class="page-profile__content">
      <div class="page-profile__avatar-wrap">
        {{{ Avatar type="button" overlayText="Поменять аватар" src=avatarSrc action="change-avatar" }}}
      </div>
      {{{ Title text=displayName titleClass="title_position_center title_size_xl" }}}
      {{{ Form formClass=profileForm.formClass actionsClass=profileForm.actionsClass name="profile-info" fields=profileForm.fields actions=profileForm.actions disabled=profileForm.disabled onSubmit=profileForm.onSubmit }}}
      <div class="page-profile__actions">
        {{#if profileForm.disabled}}
          <div class="page-profile__actions-item">
            {{{ Button buttonClass="page-profile__action-button button_type_link" text="Изменить данные" action="edit-profile" }}}
          </div>
        {{/if}}
        {{#if passwordFormVisible}}
          <div class="page-profile__password-form">
            {{{ Form formClass=passwordForm.formClass actionsClass=passwordForm.actionsClass name=passwordForm.name fields=passwordForm.fields actions=passwordForm.actions disabled=passwordForm.disabled onSubmit=passwordForm.onSubmit }}}
          </div>
        {{/if}}
        {{#unless passwordFormVisible}}
          <div class="page-profile__actions-item">
            {{{ Button buttonClass="page-profile__action-button button_type_link" text="Изменить пароль" action="edit-password" }}}
          </div>
        {{/unless}}
        <div class="page-profile__actions-item">
          {{{ Button buttonClass="page-profile__action-button button_type_link button_color_danger" text="Выйти" action="logout" }}}
        </div>
      </div>
    </div>
  {{/layout}}
{{/page}}
