{{#> layout-page title=title mainClass="page_size_md"}}
<div class="page__profile">
  {{> ui-form formClass=profileForm.formClass name="profile-info" fields=profileForm.fields
  actions=profileForm.actions}}
  {{> ui-form formClass=avatarForm.formClass name="profile-avatar" fields=avatarForm.fields actions=avatarForm.actions}}
  {{> ui-form formClass=passwordForm.formClass name="profile-password" fields=passwordForm.fields
  actions=passwordForm.actions}}
</div>
{{/layout-page}}