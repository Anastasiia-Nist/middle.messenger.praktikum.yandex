{{#> page mainClass="page-chats"}}
  {{#> layout layoutClass="chat-layout" asideClass="chat-layout__aside" contentClass="chat-layout__content" hasAsideBlock=true}}
    {{#*inline "aside-block"}}
      {{{ ChatSidebar profileLink=sidebar.profileLink profileText=sidebar.profileText searchPlaceholder=sidebar.searchPlaceholder chats=sidebar.chats }}}
    {{/inline}}
    <section class="chat-content">
      <header class="chat-content__header">
        {{{ Avatar type="icon" }}}
        <h1 class="chat-content__title">{{activeChatName}}</h1>
      </header>

      <ul class="chat-content__messages">
        {{#each messagesByDay}}
          <li class="chat-day">
            <p class="chat-day__label">{{this.date}}</p>
            <ul class="chat-day__messages">
              {{#each this.messages}}
                {{{ ChatMessage text=this.text time=this.time isOwn=this.isOwn }}}
              {{/each}}
            </ul>
          </li>
        {{/each}}
      </ul>

      {{{ Form formClass=messageForm.formClass name=messageForm.name fields=messageForm.fields leadingActions=messageForm.leadingActions actions=messageForm.actions onSubmit=onSubmit }}}
    </section>
  {{/layout}}
{{/page}}
