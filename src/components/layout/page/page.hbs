<div class="wrapper">
  {{#> layout-header layoutHeaderClass=layoutHeaderClass}}
  {{> ui-icon href="#/" label="На главную" iconClass="header__home-link"}}
  {{> ui-nav links=layoutNavLinks}}
  {{{headerContent}}}
  {{/layout-header}}
  <main class="page {{mainClass}}">
    {{#if title}}
    {{> ui-title titleClass=layoutTitleClass text=title}}
    {{/if}}
    {{> @partial-block}}
  </main>
  {{#> layout-footer layoutFooterClass=layoutFooterClass}}
  <p>
    Верстка ошибок:
    <a class="footer__link" href="#/404">404</a>
    <a class="footer__link" href="#/500">500</a>
  </p>
  <p class="footer__content">by Anastasiia Nistratova</p>
  {{/layout-footer}}
</div>