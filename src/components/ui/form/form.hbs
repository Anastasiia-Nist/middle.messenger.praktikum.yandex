<form class="form {{formClass}}{{#if disabled}} form_disabled{{/if}}" name="{{name}}" method="post" ref="form">
  {{#if leadingActions}}
    <div class="form__actions form__actions_leading">
      {{#each leadingActions}}
        {{{ Button buttonClass=this.buttonClass type=this.type text=this.text action=this.action disabled=this.disabled title=this.title }}}
      {{/each}}
    </div>
  {{/if}}
  <div class="form__fields">
    {{#each fields}}
      {{{ Input inputClass=this.inputClass id=this.id name=this.name label=this.label type=this.type value=this.value placeholder=this.placeholder disabled=../disabled autocomplete=this.autocomplete }}}
    {{/each}}
  </div>
  {{#if actions}}
    <div class="form__actions">
      {{#each actions}}
        {{{ Button buttonClass=this.buttonClass type=this.type text=this.text action=this.action }}}
      {{/each}}
    </div>
  {{/if}}
</form>
