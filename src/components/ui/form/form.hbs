<form class="form {{formClass}}" name="{{name}}" method="post" ref="form">
  <div class="form__fields">
    {{#each fields}}
      {{{ Input inputClass=this.inputClass id=this.id name=this.name label=this.label type=this.type fieldType=this.fieldType rows=this.rows value=this.value disabled=../disabled }}}
    {{/each}}
  </div>
  {{#if actions}}
    <div class="form__actions {{actionsClass}}">
      {{#each actions}}
        {{{ Button buttonClass=this.buttonClass type=this.type text=this.text }}}
      {{/each}}
    </div>
  {{/if}}
</form>
