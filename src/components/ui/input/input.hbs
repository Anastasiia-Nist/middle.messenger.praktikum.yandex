<div class="form-field {{inputClass}}">
  <label class="form-field__label" for="{{id}}">{{label}}</label>
  {{#if (eq fieldType 'textarea')}}
    <textarea class="form-field__input" id="{{id}}" name="{{name}}" rows="{{rows}}" {{#if disabled}}disabled{{/if}}>{{value}}</textarea>
  {{else}}
    <input class="form-field__input" id="{{id}}" name="{{name}}" type="{{type}}" value="{{value}}" {{#if disabled}}disabled{{/if}} />
  {{/if}}
</div>