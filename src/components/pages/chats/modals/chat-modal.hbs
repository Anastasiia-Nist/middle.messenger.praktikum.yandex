<div class="{{hostClass}}">
  {{#> modal isOpen=isOpen title=title error=error modalClass=modalClass closeAction=closeAction}}
    {{#if isFormType}}
      {{{ Form name=formName formClass="modal-form" fields=fields actions=actions onSubmit=onSubmit }}}
    {{/if}}
    {{#if isSearchFormType}}
      {{{ Form name=formName formClass="modal-form" fields=fields actions=searchActions onSubmit=onSearchSubmit }}}
      {{#if mappedSearchResults.length}}
        <ul class="modal-user-list">
          {{#each mappedSearchResults}}
            <li class="modal-user-list__item">
              <div class="modal-user-list__info">
                <span class="modal-user-list__name">{{this.first_name}} {{this.second_name}}</span>
                <span class="modal-user-list__login">@{{this.login}}</span>
              </div>
              {{{ Button type="button" text="Добавить" buttonClass="modal-user-list__action" action=this.addAction }}}
            </li>
          {{/each}}
        </ul>
      {{/if}}
    {{/if}}
    {{#if isUserListType}}
      {{#if mappedUsers.length}}
        <ul class="modal-user-list">
          {{#each mappedUsers}}
            <li class="modal-user-list__item">
              <div class="modal-user-list__info">
                <span class="modal-user-list__name">{{this.display_name}}</span>
                <span class="modal-user-list__login">@{{this.login}}</span>
              </div>
              {{{ Button type="button" text="Удалить" buttonClass="modal-user-list__action modal-user-list__action_danger" action=this.removeAction }}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="modal-user-list__empty">В чате нет участников</p>
      {{/if}}
      <div class="modal-form__actions">
        {{{ Button type="button" text="Закрыть" buttonClass="button_stretch_full" action=closeAction }}}
      </div>
    {{/if}}
  {{/modal}}
</div>
